rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 練習頁不登入。sets、words、sessions 都可讀。
    // 練習頁可建立 sessions。sets／words 只有已登入家長能寫。
    // 其餘路徑預設拒絕。

    match /sets/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /words/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /sessions/{id} {
      allow read: if true;
      allow create: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
