  "mode_copy": {
    "A": {
      "name": "點選拼音",
      "intro": "看字詞，選出聲母、韻母和聲調。",
      "before": "請選出正確的聲母、韻母和聲調。選錯會立刻看到正確答案。",
      "prompt": "請為「{詞}」選出拼音。",
      "syllable": "第 {n} 個字",
      "correct": "答對了！",
      "wrong": "不對。正確是：{正解帶調拼音}",
      "word_done": "完成！",
      "set_done": "這組練習完成了，做得好！"
    },
    "B": {
      "name": "認讀選擇",
      "intro": "看帶調拼音，輸入正確的繁體字詞。",
      "prompt": "請寫出讀作 {帶調拼音} 的字詞。",
      "correct": "答對了！",
      "wrong": "不對。正確是：{漢字}（{帶調拼音}）",
      "set_done": "這組練習完成了，做得好！"
    },
    "C": {
      "name": "組合拼音",
      "intro": "聽詞語，選出聲母、韻母和聲調。",
      "before": "請聽一聽，選出正確的聲母、韻母和聲調。選錯會立刻看到正確答案。",
      "prompt": "聽一聽，選出正確的聲母、韻母和聲調。",
      "prompt_fallback": "請看字，選出正確的聲母、韻母和聲調。",
      "replay": "再聽一次",
      "syllable": "第 {n} 個字",
      "correct": "答對了！",
      "wrong": "不對。正確是：{正解帶調拼音}",
      "word_done": "完成！",
      "set_done": "這組練習完成了，做得好！",
      "no_speech": "這個瀏覽器不能朗讀。請改用支援中文語音的瀏覽器，或請旁邊的人讀出詞語。字詞會顯示出來，仍可練習。"
    }
  },
  "polyphone_policy": {
    "rule": "只收小學／日常常見讀音；本題詞義下常見讀音皆可入 accept；不發明生僻讀音；判定只比 accept／word_accept",
    "normalize": [
      "lowercase",
      "ü≡v",
      "jqx後u≡ü",
      "trim_spaces"
    ]
  }
}